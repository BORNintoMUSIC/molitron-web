{
  "name": "molitron-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts eslint.config.mjs next.config.ts",
    "check": "next typegen && tsc --noEmit && npm run lint && node scripts/validate-site-content.mjs --changed",
    "check:full": "npm run lint && node scripts/validate-site-content.mjs --all && next build",
    "optimize-images": "node scripts/optimize-images.mjs"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "not dead",
    "not op_mini all"
  ],
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.2.9",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.180.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
